# Demonstration store by default. Never commit `.env`.
VITE_DATA_MODE=demo

# Supabase (anon / publishable key only — never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Xendit: do NOT put secret keys here. The Vite app cannot safely hold xnd_* secrets.
# Configure XENDIT_SECRET_KEY and XENDIT_WEBHOOK_TOKEN in Supabase → Edge Functions → Secrets.
