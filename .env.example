# Never commit `.env`.
# Omit VITE_DATA_MODE or set `production` when Supabase URL + anon key are set.
# Set `demo` only for local demonstration catalogue (no live database).
VITE_DATA_MODE=production

# Supabase (anon / publishable key only — never the service role key)
# Required for production sign-in and live catalogue. Baked in at `vite build` time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Xendit: do NOT put secret keys here. The Vite app cannot safely hold xnd_* secrets.
# Configure XENDIT_SECRET_KEY and XENDIT_WEBHOOK_TOKEN in Supabase → Edge Functions → Secrets.
